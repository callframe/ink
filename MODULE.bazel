module(name = "ink")

bazel_dep(name = "toolchains_llvm", version = "1.8.0")
bazel_dep(name = "rules_rust", version = "0.71.3")

bazel_dep(name = "rules_foreign_cc")
git_override(
    module_name = "rules_foreign_cc",
    remote = "https://github.com/bazel-contrib/rules_foreign_cc.git",
    commit = "f68b351c4691e747f889dc5e4c2cac3cd3b66ea2",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "21.1.8")
use_repo(llvm, "llvm_toolchain")
register_toolchains("@llvm_toolchain//:all")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(versions = ["nightly/2026-08-01"])

include("//bazel:crates.MODULE.bazel")
